//@version=6
// ============================================================================
// ROBÔ CRIPTO — Seguir tendência (EMA 9/21 + filtro EMA 200 + RSI)
// Mesma lógica do robô em Python e do app para celular:
//   COMPRA quando há tendência de alta (EMA rápida > lenta, preço > EMA 200 e
//   EMA 200 subindo) e aparece um gatilho: cruzamento da EMA rápida para cima
//   da lenta, ou retomada (preço corrige abaixo da EMA rápida e volta para cima).
//   Só compra com RSI abaixo de 70.
//   VENDE no cruzamento para baixo, no stop (3 x ATR), no alvo (4 x ATR) ou no
//   stop móvel, que sobe junto com o preço.
//   Sinal no fechamento do candle, execução na abertura do seguinte.
// Comissão padrão de 0,15% por ordem = taxa de 0,1% + slippage estimado de 0,05%.
// Ferramenta de estudo. Não é recomendação de investimento.
// ============================================================================
strategy("Robô Cripto — Tendência EMA + RSI", shorttitle = "Robô Cripto", overlay = true,
     initial_capital = 1000, pyramiding = 0,
     commission_type = strategy.commission.percent, commission_value = 0.15,
     process_orders_on_close = false, max_labels_count = 500)

// ---------------------------------------------------------------- parâmetros
const string G1 = "Estratégia"
const string G2 = "Gestão de risco"
const string G3 = "Visual"
emaRapidaLen = input.int(9,     "EMA rápida",               minval = 1, group = G1)
emaLentaLen  = input.int(21,    "EMA lenta",                minval = 1, group = G1)
emaFiltroLen = input.int(200,   "EMA filtro de tendência",  minval = 1, group = G1)
rsiLen       = input.int(14,    "Período do RSI",           minval = 1, group = G1)
rsiMax       = input.float(70,  "RSI máximo para comprar",  minval = 1, maxval = 100, group = G1)
atrLen       = input.int(14,    "Período do ATR",           minval = 1, group = G2)
stopMult     = input.float(3.0, "Stop loss (x ATR)",        minval = 0.1, step = 0.1, group = G2)
alvoMult     = input.float(4.0, "Alvo (x ATR, 0 = sem alvo)", minval = 0, step = 0.1, group = G2)
usarTrailing = input.bool(true, "Stop móvel (sobe com o preço)", group = G2)
riscoPct     = input.float(1.0, "Risco por operação (% do capital)", minval = 0.1, maxval = 100, step = 0.1, group = G2)
exposicaoPct = input.float(95,  "Uso máximo do capital (%)", minval = 1, maxval = 100, group = G2)
mostrarPainel = input.bool(true, "Mostrar painel", group = G3)
mostrarFundo  = input.bool(true, "Colorir fundo em tendência de alta", group = G3)

// ---------------------------------------------------------------- indicadores
emaR = ta.ema(close, emaRapidaLen)
emaL = ta.ema(close, emaLentaLen)
emaF = ta.ema(close, emaFiltroLen)
rsiV = ta.rsi(close, rsiLen)
atrV = ta.atr(atrLen)

// ---------------------------------------------------------------- sinais
acima         = emaR > emaL
cruzouCima    = acima and not acima[1]
cruzouBaixo   = not acima and acima[1]
acimaRapida   = close > emaR
retomada      = acima and acimaRapida and not acimaRapida[1]
acimaFiltro   = close > emaF
filtroSubindo = emaF > emaF[10]
regime        = acima and acimaFiltro and filtroSubindo
aquecido      = bar_index >= emaFiltroLen

sinalCompra = aquecido and (cruzouCima or retomada) and regime and rsiV < rsiMax
sinalVenda  = aquecido and cruzouBaixo

// ---------------------------------------------------------------- ordens
var float stopNivel  = na
var float alvoNivel  = na
var float maiorPreco = na

emPosicao = strategy.position_size > 0

// stop móvel: usa a máxima e o ATR do candle fechado, vale a partir do próximo
if emPosicao and usarTrailing
    maiorPreco := math.max(nz(maiorPreco, high), high)
    stopNivel  := math.max(stopNivel, maiorPreco - stopMult * atrV)

if sinalVenda and emPosicao
    strategy.close("Compra", comment = "Cruzou p/ baixo")
    alert("VENDA " + syminfo.ticker + " (" + timeframe.period + ") — EMA rápida cruzou para baixo da lenta. Preço " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if sinalCompra and not emPosicao
    stopNivel  := close - stopMult * atrV
    alvoNivel  := alvoMult > 0 ? close + alvoMult * atrV : na
    maiorPreco := close
    riscoUnit   = math.max(close - stopNivel, close * 0.002)
    qtd         = math.min(strategy.equity * riscoPct / 100 / riscoUnit, strategy.equity * exposicaoPct / 100 / close)
    strategy.entry("Compra", strategy.long, qty = qtd, comment = "Compra")
    alert("COMPRA " + syminfo.ticker + " (" + timeframe.period + ") — preço " + str.tostring(close, format.mintick) + " | stop " + str.tostring(stopNivel, format.mintick) + (na(alvoNivel) ? "" : " | alvo " + str.tostring(alvoNivel, format.mintick)), alert.freq_once_per_bar_close)

// a saída (stop/alvo) fica ativa desde o candle da entrada e é atualizada a cada candle
if emPosicao or sinalCompra
    strategy.exit("Saída", from_entry = "Compra", stop = stopNivel, limit = alvoNivel, comment_loss = "Stop", comment_profit = "Alvo")

if not emPosicao and not sinalCompra
    stopNivel  := na
    alvoNivel  := na
    maiorPreco := na

// ---------------------------------------------------------------- gráfico
plot(emaR, "EMA rápida", color = color.new(#2B54D9, 0), linewidth = 2)
plot(emaL, "EMA lenta",  color = color.new(#E8A33D, 0), linewidth = 2)
plot(emaF, "EMA filtro", color = color.new(color.gray, 0), linewidth = 1)
plot(emPosicao ? stopNivel : na, "Stop", color = color.new(color.red, 0),   style = plot.style_linebr, linewidth = 1)
plot(emPosicao ? alvoNivel : na, "Alvo", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 1)
plotshape(sinalCompra, title = "Sinal de compra", style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(sinalVenda,  title = "Sinal de venda",  style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.small)
bgcolor(mostrarFundo and regime ? color.new(color.green, 93) : na, title = "Tendência de alta")

// ---------------------------------------------------------------- painel
var table painel = table.new(position.top_right, 3, 7, bgcolor = color.new(#151C2E, 10), border_color = color.new(#283352, 0), border_width = 1, frame_color = color.new(#283352, 0), frame_width = 1)

marca(ok) => ok ? "✓" : "✗"
corOk(ok) => ok ? color.new(#3CC48A, 0) : color.new(#FF6B74, 0)

if mostrarPainel and barstate.islast
    estado = sinalCompra ? "COMPRA" : sinalVenda ? "VENDA" : emPosicao ? "COMPRADO" : regime ? "EM TENDÊNCIA" : "FORA DO MERCADO"
    corEstado = sinalCompra or emPosicao ? color.new(#3CC48A, 0) : sinalVenda ? color.new(#FF6B74, 0) : regime ? color.new(#7F9CFF, 0) : color.new(#E8B04B, 0)
    branco = color.new(#E8ECF5, 0)
    cinza  = color.new(#95A0B8, 0)
    table.cell(painel, 0, 0, "Robô Cripto", text_color = branco, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 0, estado, text_color = corEstado, text_size = size.small)
    table.merge_cells(painel, 1, 0, 2, 0)
    table.cell(painel, 0, 1, "EMA rápida > lenta", text_color = cinza, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 1, marca(acima), text_color = corOk(acima), text_size = size.small)
    table.cell(painel, 2, 1, str.tostring(emaR, format.mintick), text_color = cinza, text_size = size.small)
    table.cell(painel, 0, 2, "Preço > EMA filtro", text_color = cinza, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 2, marca(acimaFiltro), text_color = corOk(acimaFiltro), text_size = size.small)
    table.cell(painel, 2, 2, str.tostring(emaF, format.mintick), text_color = cinza, text_size = size.small)
    table.cell(painel, 0, 3, "EMA filtro subindo", text_color = cinza, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 3, marca(filtroSubindo), text_color = corOk(filtroSubindo), text_size = size.small)
    table.cell(painel, 2, 3, str.tostring((emaF / emaF[10] - 1) * 100, "#.##") + "%", text_color = cinza, text_size = size.small)
    table.cell(painel, 0, 4, "RSI < " + str.tostring(rsiMax), text_color = cinza, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 4, marca(rsiV < rsiMax), text_color = corOk(rsiV < rsiMax), text_size = size.small)
    table.cell(painel, 2, 4, str.tostring(rsiV, "#.0"), text_color = cinza, text_size = size.small)
    table.cell(painel, 0, 5, "Stop / alvo", text_color = cinza, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 5, emPosicao ? str.tostring(stopNivel, format.mintick) : "—", text_color = color.new(#FF6B74, 0), text_size = size.small)
    table.cell(painel, 2, 5, emPosicao and not na(alvoNivel) ? str.tostring(alvoNivel, format.mintick) : "—", text_color = color.new(#3CC48A, 0), text_size = size.small)
    table.cell(painel, 0, 6, "Só simulação · não é recomendação", text_color = cinza, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(painel, 0, 6, 2, 6)
